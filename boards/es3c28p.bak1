// ES3C28P - ESP32-S3 + 2.8" ILI9341 240x320 + FT6336G touch + microSD.
// Board configuration for ES3C28P (LCDWiki).
// Pinout verified against official LCDWiki specification (CR2025-M16872).
#ifndef BOARD_CONFIG_H
#define BOARD_CONFIG_H

#include "../MoneroColdWallet/src/config/app_config.h"
#define BOARD_NAME "ES3C28P"

// ===== Display =====
#define DISPLAY_DRIVER   DISPLAY_ILI9341
#define DISPLAY_WIDTH    240
#define DISPLAY_HEIGHT   320
#define DISPLAY_ROTATION 0
#define TFT_CS           10
#define TFT_DC           46
#define TFT_RST          -1   // RST подключён к CHIP_PU (пин сброса платы)
#define TFT_MOSI         11
#define TFT_MISO         13
#define TFT_SCK          12
#define TFT_BL           45   // Подсветка на GPIO45
#define TFT_BL_ACTIVE_HIGH 0

// ===== Touch =====
#define HAS_TOUCH        1
#define TOUCH_DRIVER     TOUCH_FT6336G
#define TOUCH_SDA        16
#define TOUCH_SCL        15
#define TOUCH_INT        17
#define TOUCH_RST        18

// ===== SD Card (SDIO mode, not SPI) =====
// Внимание: на этой плате SD-карта подключена через SDIO, а не SPI.
// Если ваш скетч использует SPI-режим SD, потребуется адаптация.
#define HAS_SD           1
#define SD_CS            -1   // Не используется в SDIO
#define SD_MISO          -1   // Не используется в SDIO
#define SD_MOSI          -1   // Не используется в SDIO
#define SD_SCK           -1   // Не используется в SDIO
// SDIO pins (если скетч поддерживает SDIO):
#define SD_CLK           38
#define SD_CMD           40
#define SD_D0            39
#define SD_D1            41
#define SD_D2            48
#define SD_D3            47

// ===== Camera =====
#define HAS_CAMERA       0
#define CAM_PIN_PWDN     -1
#define CAM_PIN_RESET    -1
#define CAM_PIN_XCLK     -1
#define CAM_PIN_SIOD     -1
#define CAM_PIN_SIOC     -1
#define CAM_PIN_D7       -1
#define CAM_PIN_D6       -1
#define CAM_PIN_D5       -1
#define CAM_PIN_D4       -1
#define CAM_PIN_D3       -1
#define CAM_PIN_D2       -1
#define CAM_PIN_D1       -1
#define CAM_PIN_D0       -1
#define CAM_PIN_VSYNC    -1
#define CAM_PIN_HREF     -1
#define CAM_PIN_PCLK     -1

// ===== Buttons =====
#define HAS_BUTTONS      0
#define BUTTON_UP        -1
#define BUTTON_DOWN      -1
#define BUTTON_LEFT      -1
#define BUTTON_RIGHT     -1
#define BUTTON_SELECT    -1
#define BUTTON_BACK      -1
#define BUTTON_ENCODER_A -1
#define BUTTON_ENCODER_B -1

// ===== Feature flags =====
#define HAS_PSRAM        1
#define PSRAM_SIZE_MB    8
#define HAS_HMAC         1
#define HAS_USB_OTG      1

// ===== Default input mode =====
#define DEFAULT_SEED_INPUT_MODE  SEED_INPUT_AUTO

#endif